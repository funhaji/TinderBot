{
  "name": "telegram-friend-finding-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "migrate": "node dist/db/migrate.js",
    "migrate:dev": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "global-agent": "^3.0.0",
    "grammy": "^1.36.1",
    "jalaali-js": "^1.2.8",
    "pg": "^8.16.3",
    "pino": "^9.9.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/pg": "^8.15.4",
    "tsx": "^4.19.4",
    "typescript": "^5.9.2"
  }
}

